# Copy to .env.local (gitignored) and fill in. Never commit real values.
#
# WRDS academic seat — required to regenerate the CRSP Treasury layer of the panel.
# CRSP data is licensed via WRDS and is NOT redistributable; a WRDS subscriber
# regenerates the CRSP-derived fields locally (see data/README.md).
WRDS_USERNAME=
WRDS_PASSWORD=
WRDS_ENABLED=

# Public sources below need NO credentials (Treasury fiscaldata, TreasuryDirect,
# Treasury par yield curve). Listed for completeness; leave empty.
# FRED_API_KEY is optional (only for the constant-maturity cross-check).
FRED_API_KEY=
